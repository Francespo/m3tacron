{
  "worktree": {
    "setup": "bash scripts/local_dev/worktree_setup.sh",
    "teardown": "bash scripts/local_dev/up.sh --stop 2>/dev/null || true\nrm -rf .venv frontend/node_modules .pytest_cache local-data",
    "servicePorts": { "range": "9000-9100" }
  },
  "scripts": {
    "local": {
      "command": "bash scripts/local_dev/up.sh"
    },
    "launch": {
      "type": "service",
      "command": "bash scripts/local_dev/launch.sh",
      "port": 3335
    },
    "seed": {
      "command": "bash scripts/local_dev/seed.sh"
    },
    "reset": {
      "command": "bash scripts/local_dev/reset.sh"
    },
    "status": {
      "command": "bash scripts/local_dev/status.sh"
    },
    "test": {
      "command": ". .venv/bin/activate && pytest"
    },
    "test:backend": {
      "command": ". .venv/bin/activate && pytest backend/tests"
    },
    "lint": {
      "command": "npm run check --prefix frontend"
    },
    "db": {
      "command": "bash scripts/local_dev/db.sh"
    },
    "backend": {
      "type": "service",
      "command": "docker compose -f docker-compose.local.yml up --build --abort-on-container-exit postgres db-seed backend",
      "port": 8890
    },
    "frontend": {
      "type": "service",
      "command": "VITE_API_BASE=\"http://localhost:$PASEO_SERVICE_BACKEND_PORT/api\" npm run dev --prefix frontend -- --host 0.0.0.0 --port $PASEO_PORT",
      "port": 3335
    }
  }
}
